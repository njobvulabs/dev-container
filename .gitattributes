# Normalize line endings so shell scripts keep working when cloned on Windows.
* text=auto eol=lf

*.sh text eol=lf
*.env text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
