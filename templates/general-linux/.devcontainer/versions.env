# Canonical tool versions for Cloud Dev Templates.
# Sourced by common.sh. Values already set in the environment take precedence.
#
# Update a version here, run ./scripts/sync-template-assets.sh, then rebuild
# the container. Keep README.md and the template READMEs in sync; the
# repository validator checks the main version table.

: "${NODE_VERSION:=26.13.0}"
: "${JAVA_MAJOR:=21}"
: "${GRADLE_VERSION:=9.6.0}"
: "${ANDROID_CMDLINE_TOOLS_VERSION:=15859902}"
: "${ANDROID_CMDLINE_TOOLS_SHA256:=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583}"
: "${ANDROID_PLATFORM:=android-37.0}"
: "${ANDROID_BUILD_TOOLS:=36.0.0}"
: "${OPENCODE_VERSION:=2.2.6}"

export NODE_VERSION JAVA_MAJOR GRADLE_VERSION
export ANDROID_CMDLINE_TOOLS_VERSION ANDROID_CMDLINE_TOOLS_SHA256
export ANDROID_PLATFORM ANDROID_BUILD_TOOLS
export OPENCODE_VERSION
